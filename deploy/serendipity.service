[Unit]
Description=Serendipity Elementary School Chatbot API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/serendipity
EnvironmentFile=/var/www/serendipity/.env
ExecStart=/var/www/serendipity/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
