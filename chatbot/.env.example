# Export these in your shell before starting the server, e.g.:
#   export GAPGPT_API_KEY=your-gapgpt-api-key-here
#   export DEFAULT_BASE_URL=https://api.gapgpt.app/v1
#   export DEFAULT_MODEL=gpt-5-mini
#
# Or start uvicorn with:
#   uvicorn main:app --reload --port 8000 --env-file .env

GAPGPT_API_KEY=your-gapgpt-api-key-here
DEFAULT_BASE_URL=https://api.gapgpt.app/v1
DEFAULT_MODEL=gpt-5-mini
