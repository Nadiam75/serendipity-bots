# Copy to .env and fill in. Never commit .env.
# On VPS (systemd): avoid quotes around values — use KEY=value

AVALAI_API_KEY=your-avalai-api-key-here
AVALAI_BASE_URL=https://api.avalai.ir/v1
# Default model when request omits "model"
DEFAULT_MODEL=gpt-5.6-luna
# Max prior turns (user+assistant pairs) sent to the LLM; Laravel may store more in DB
MAX_HISTORY_TURNS=20
# Max tokens generated per AvalAI response (chat + assess)
MAX_OUTPUT_TOKENS=500
